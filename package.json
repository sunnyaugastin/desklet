{
  "name": "desklet",
  "productName": "Desklet",
  "version": "2.0.0",
  "description": "Run HTML apps as native desktop apps",
  "main": "main.js",
  "author": "Sunny Augastin",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.sunny.desklet",
    "copyright":
      "Copyright © 2025 Sunny Augastin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "icon": "assets/default.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Desklet"
    }
  },
  "dependencies": {
  "windows-shortcuts": "^0.1.5"
},
"devDependencies": {
  "electron": "^30.0.0",
  "electron-builder": "^26.0.12"
}

}
